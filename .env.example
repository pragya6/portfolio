# Settings for the assistant API. Copy to .env for local work, and paste the
# same names into Vercel > Project > Settings > Environment Variables.
#
# .env is gitignored. Never commit real values. Nothing here is read by the
# page in the browser: every one of these stays on the server.


# ---------------------------------------------------------------- model
# Primary model. The 3.x line is the supported one for new work and carries
# the larger daily allowance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Used only if the primary returns a model-not-found or access error, so a
# model being retired does not take the assistant down with it.
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite


# ---------------------------------------------------------------- access
# Who may call the API. Comma separated, no trailing slash. Anything else is
# refused before the request reaches the model.
ALLOWED_ORIGINS=https://pragya6.github.io,http://127.0.0.1:5500,http://localhost:5500


# ---------------------------------------------------------------- caps
# Deliberately far below the provider's own limits. The point is not cost:
# it is that a scripted run must not burn the daily allowance and leave the
# assistant dead for a real visitor.
MAX_MESSAGES_PER_SESSION=12
MAX_REQUESTS_PER_HOUR_PER_IP=30
DAILY_REQUEST_CAP=1500

# Past the daily cap the assistant stops answering and the page shows a
# static fallback instead of an error.
OVER_CAP_MESSAGE=The assistant is resting for today — the resume and links on this page still work.


# ---------------------------------------------------------------- links
# The assistant never sees these. It names a key such as CRM_AGENT, and the
# server swaps in the address when it builds an email. That is why a prompt
# injection cannot make it hand out a link: it has no link to hand out.
LINK_SWE_RESUME=
LINK_GENAI_RESUME=
LINK_PORTFOLIO=
LINK_LINKEDIN=
LINK_GITHUB=
LINK_CRM_AGENT=
LINK_HOMOEO_QUIZ=


# ---------------------------------------------------------------- later phases
# Left blank until the phase that needs them. Blank means the feature is off,
# not broken.

# Phase 5 — human check in front of the API (Cloudflare Turnstile)
TURNSTILE_SECRET=

# Phase 6 — sending mail, without an inbox or a login
RESEND_API_KEY=
MAIL_FROM=
DAILY_EMAIL_CAP=5

# Phase 7 — visit and conversation logs, and the notification to you
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NOTIFY_EMAIL=
